require('dotenv').config();
const mongoose = require('mongoose');
const bcrypt = require('bcryptjs');
const User = require('./models/User');

const adminEmail = process.env.ADMIN_EMAIL || 'admin@skillnest.com';
const adminPassword = process.env.ADMIN_PASSWORD;

if (!adminPassword) {
  console.error('ADMIN_PASSWORD is required to create an admin user.');
  process.exit(1);
}

mongoose.connect(process.env.MONGO_URI).then(async () => {
  const hashedPassword = await bcrypt.hash(adminPassword, 10);
  const admin = new User({
    name: 'Admin',
    email: adminEmail,
    password: hashedPassword,
    role: 'admin'
  });

  const existingAdmin = await User.findOne({ email: adminEmail });
  if (existingAdmin) {
    console.log(`Admin already exists for ${adminEmail}`);
    mongoose.connection.close();
    return;
  }

  await admin.save();
  console.log(`Admin created! Email: ${adminEmail}`);
  mongoose.connection.close();
}).catch(err => console.log(err));
